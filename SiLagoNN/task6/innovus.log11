@file 5:
@file 6: #2. set width for Silago design blocks
@file 7: set tile_width 200
@file 8:
@file 9: #3. set height for Silago design blocks
@file 10: set tile_height 200
@file 11:
@file 12: #4. create floorplan area
@@file 13: create_floorplan -site SC8T_104CPP_CMOS22FDX -core_size [expr {2*$margin + 8*$tile_width}] [expr {2*$margin + 2*$tile_height}] $margin $margin $margin $margin -no_snap_to_grid

Honor LEF defined pitches for advanced node
Start create_tracks
**WARN: (IMPFP-325):	Floorplan of the design is resized. All current create_floorplan objects are automatically derived based on specified new create_floorplan. This may change blocks, fixed standard cells, existing routes and blockages.
@file 14:
@file 15: #5. Creating boundary constraints for Silago design blocks
@file 16: for {set i 0} {$i < 8} {incr i} {

#Top row	
    #set x1 
    set x1 [expr {double($margin + $tile_width * $i)}]

    #set y1 
    set y1 [expr {double($margin + $tile_height)}]

    #set x2 
    set x2 [expr {double($x1 + $tile_width)}]

    #set y2 
    set y2 [expr {double($y1 + $tile_height)}]

    #set the cell 
    set cell [lindex ${partition_hinst_list} $i]

    #create_boundary_constraint for the cell
    create_boundary_constraint -type fence -hinst $cell \
        -rects [list [list $x1 $y1 $x2 $y2]]

#Bottom row
    #set x1 
    set x1 [expr {double($margin + $tile_width * $i)}]

    #set y1 
    set y1 [expr {double($margin)}]

    #set x2 
    set x2 [expr {double($x1 + $tile_width)}]

    #set y2 
    set y2 [expr {double($y1 + $tile_height)}]

    #set the cell 
    set cell [lindex ${partition_hinst_list} [expr {$i + 8}]]

    #create_boundary_constraint for the cell
    create_boundary_constraint -type fence -hinst $cell \
        -rects [list [list $x1 $y1 $x2 $y2]]
}
@file 58:
#@ End verbose source ../phy/scr/floorplan_constrained.tcl
@file 3:
@file 4: foreach part_hinst ${partition_hinst_list} {
# 1. create partitions for ALL design blocks
create_partition -hinst ${part_hinst} -core_spacing 0.0 0.0 0.0 0.0 -rail_width 0.0 -min_pitch_left 2 \
                    -min_pitch_right 2 -min_pitch_top 2 -min_pitch_bottom 2 -reserved_layer {1 2 3 4} \
                     -pin_layer_top {3 5 7 9} -pin_layer_left {2 4 6 8} -pin_layer_bottom {3 5 7 9} \
                     -pin_layer_right {2 4 6 8} -place_halo 10.0 0.0 0.0 0.0 -route_halo 10.0 -route_halo_top_layer 4 \
                    -route_halo_bottom_layer 1
}
