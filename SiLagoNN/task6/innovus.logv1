[12/29 19:34:31   1279s] @file 14:
[12/29 19:34:31   1279s] @file 15: #5. Creating boundary constraints for Silago design blocks
[12/29 19:34:31   1279s] @file 16: for {set i 0} {$i < 8} {incr i} {
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s] #Top row	
[12/29 19:34:31   1279s]     #set x1 
[12/29 19:34:31   1279s]     set x1 [expr {double($margin + $tile_width * $i)}]
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s]     #set y1 
[12/29 19:34:31   1279s]     set y1 [expr {double($margin + $tile_height)}]
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s]     #set x2 
[12/29 19:34:31   1279s]     set x2 [expr {double($x1 + $tile_width)}]
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s]     #set y2 
[12/29 19:34:31   1279s]     set y2 [expr {double($y1 + $tile_height)}]
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s]     #set the cell 
[12/29 19:34:31   1279s]     set cell [lindex ${partition_hinst_list} $i]
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s]     #create_boundary_constraint for the cell
[12/29 19:34:31   1279s]     create_boundary_constraint -type fence -hinst $cell \
[12/29 19:34:31   1279s]         -rects [list [list $x1 $y1 $x2 $y2]]
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s] #Bottom row
[12/29 19:34:31   1279s]     #set x1 
[12/29 19:34:31   1279s]     set x1 [expr {double($margin + $tile_width * $i)}]
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s]     #set y1 
[12/29 19:34:31   1279s]     set y1 [expr {double($margin)}]
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s]     #set x2 
[12/29 19:34:31   1279s]     set x2 [expr {double($x1 + $tile_width)}]
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s]     #set y2 
[12/29 19:34:31   1279s]     set y2 [expr {double($y1 + $tile_height)}]
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s]     #set the cell 
[12/29 19:34:31   1279s]     set cell [lindex ${partition_hinst_list} [expr {$i + 8}]]
[12/29 19:34:31   1279s] 
[12/29 19:34:31   1279s]     #create_boundary_constraint for the cell
[12/29 19:34:31   1279s]     create_boundary_constraint -type fence -hinst $cell \
[12/29 19:34:31   1279s]         -rects [list [list $x1 $y1 $x2 $y2]]
[12/29 19:34:31   1279s] }
