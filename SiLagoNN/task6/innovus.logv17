[01/02 11:18:50   1483s] @file 2:
[01/02 11:18:50   1483s] @file 3: #1. set margin
[01/02 11:18:50   1483s] @file 4: set margin 10
[01/02 11:18:50   1483s] @file 5:
[01/02 11:18:50   1483s] @file 6: #2. set width for Silago design blocks
[01/02 11:18:50   1483s] @file 7: set tile_width 200
[01/02 11:18:50   1483s] @file 8:
[01/02 11:18:50   1483s] @file 9: #3. set height for Silago design blocks
[01/02 11:18:50   1483s] @file 10: set tile_height 200
[01/02 11:18:50   1483s] @file 11:
[01/02 11:18:50   1483s] @file 12: #4. create floorplan area
[01/02 11:18:50   1483s] @@file 13: create_floorplan -site SC8T_104CPP_CMOS22FDX -core_size [expr {2*$margin + 8*$tile_width}] [expr {2*$margin + 2*$tile_height}] $margin $margin $margin $margin -no_snap_to_grid
[01/02 11:18:51   1484s] 
[01/02 11:18:51   1484s] Honor LEF defined pitches for advanced node
[01/02 11:18:51   1484s] Start create_tracks
[01/02 11:18:51   1484s] **WARN: (IMPFP-325):	Floorplan of the design is resized. All current create_floorplan objects are automatically derived based on specified new create_floorplan. This may change blocks, fixed standard cells, existing routes and blockages.
[01/02 11:18:51   1485s] @file 14:
[01/02 11:18:51   1485s] @file 15: #5. Creating boundary constraints for Silago design blocks
[01/02 11:18:51   1485s] @file 16: for {set i 0} {$i < 8} {incr i} {
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s] #Top row	
[01/02 11:18:51   1485s]     #set x1 
[01/02 11:18:51   1485s]     set x1 [expr {double($margin + $tile_width * $i)}]
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s]     #set y1 
[01/02 11:18:51   1485s]     set y1 [expr {double($margin + $tile_height)}]
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s]     #set x2 
[01/02 11:18:51   1485s]     set x2 [expr {double($x1 + $tile_width)}]
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s]     #set y2 
[01/02 11:18:51   1485s]     set y2 [expr {double($y1 + $tile_height)}]
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s]     #set the cell 
[01/02 11:18:51   1485s]     set cell [lindex ${partition_hinst_list} $i]
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s]     #create_boundary_constraint for the cell
[01/02 11:18:51   1485s]     create_boundary_constraint -type fence -hinst $cell \
[01/02 11:18:51   1485s]         -rects [list [list $x1 $y1 $x2 $y2]]
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s] #Bottom row
[01/02 11:18:51   1485s]     #set x1 
[01/02 11:18:51   1485s]     set x1 [expr {double($margin + $tile_width * $i)}]
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s]     #set y1 
[01/02 11:18:51   1485s]     set y1 [expr {double($margin)}]
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s]     #set x2 
[01/02 11:18:51   1485s]     set x2 [expr {double($x1 + $tile_width)}]
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s]     #set y2 
[01/02 11:18:51   1485s]     set y2 [expr {double($y1 + $tile_height)}]
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s]     #set the cell 
[01/02 11:18:51   1485s]     set cell [lindex ${partition_hinst_list} [expr {$i + 8}]]
[01/02 11:18:51   1485s] 
[01/02 11:18:51   1485s]     #create_boundary_constraint for the cell
[01/02 11:18:51   1485s]     create_boundary_constraint -type fence -hinst $cell \
[01/02 11:18:51   1485s]         -rects [list [list $x1 $y1 $x2 $y2]]
[01/02 11:18:51   1485s] }
[01/02 11:18:51   1485s] @file 58:
[01/02 11:18:51   1485s] #@ End verbose source ../phy/scr/floorplan_constrained.tcl
