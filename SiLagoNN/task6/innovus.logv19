[01/02 19:09:46   1524s] @file 14:
[01/02 19:09:46   1524s] @file 15: #5. Creating boundary constraints for Silago design blocks
[01/02 19:09:46   1524s] @file 16: for {set i 0} {$i < 8} {incr i} {
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s] #Top row	
[01/02 19:09:46   1524s]     #set x1 
[01/02 19:09:46   1524s]     set x1 [expr {double($margin + $tile_width * $i)}]
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s]     #set y1 
[01/02 19:09:46   1524s]     set y1 [expr {double($margin + $tile_height)}]
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s]     #set x2 
[01/02 19:09:46   1524s]     set x2 [expr {double($x1 + $tile_width)}]
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s]     #set y2 
[01/02 19:09:46   1524s]     set y2 [expr {double($y1 + $tile_height)}]
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s]     #set the cell 
[01/02 19:09:46   1524s]     set cell [lindex ${partition_hinst_list} $i]
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s]     #create_boundary_constraint for the cell
[01/02 19:09:46   1524s]     create_boundary_constraint -type fence -hinst $cell -rects [list [list $x1 $y1 $x2 $y2]]
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s] #Bottom row
[01/02 19:09:46   1524s]     #set x1 
[01/02 19:09:46   1524s]     set x1 [expr {double($margin + $tile_width * $i)}]
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s]     #set y1 
[01/02 19:09:46   1524s]     set y1 [expr {double($margin)}]
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s]     #set x2 
[01/02 19:09:46   1524s]     set x2 [expr {double($x1 + $tile_width)}]
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s]     #set y2 
[01/02 19:09:46   1524s]     set y2 [expr {double($y1 + $tile_height)}]
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s]     #set the cell 
[01/02 19:09:46   1524s]     set cell [lindex ${partition_hinst_list} [expr {$i + 8}]]
[01/02 19:09:46   1524s] 
[01/02 19:09:46   1524s]     #create_boundary_constraint for the cell
[01/02 19:09:46   1524s]     create_boundary_constraint -type fence -hinst $cell -rects [list [list $x1 $y1 $x2 $y2]]
[01/02 19:09:46   1524s] }
