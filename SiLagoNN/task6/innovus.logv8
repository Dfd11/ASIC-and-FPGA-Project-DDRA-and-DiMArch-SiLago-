[12/31 13:43:36   1412s] @file 2:
[12/31 13:43:36   1412s] @file 3: #1. set margin
[12/31 13:43:36   1412s] @file 4: set margin 10
[12/31 13:43:36   1412s] @file 5:
[12/31 13:43:36   1412s] @file 6: #2. set width for Silago design blocks
[12/31 13:43:36   1412s] @file 7: set tile_width 200
[12/31 13:43:36   1412s] @file 8:
[12/31 13:43:36   1412s] @file 9: #3. set height for Silago design blocks
[12/31 13:43:36   1412s] @file 10: set tile_height 200
[12/31 13:43:36   1412s] @file 11:
[12/31 13:43:36   1412s] @file 12: #4. create floorplan area
[12/31 13:43:36   1412s] @@file 13: create_floorplan -site SC8T_104CPP_CMOS22FDX -core_size [expr {2*$margin + 8*$tile_width}] [expr {2*$margin + 2*$tile_height}] $margin $margin $margin $margin -no_snap_to_grid
[12/31 13:43:37   1413s] 
[12/31 13:43:37   1413s] Honor LEF defined pitches for advanced node
[12/31 13:43:37   1413s] Start create_tracks
[12/31 13:43:37   1413s] **WARN: (IMPFP-325):	Floorplan of the design is resized. All current create_floorplan objects are automatically derived based on specified new create_floorplan. This may change blocks, fixed standard cells, existing routes and blockages.
[12/31 13:43:38   1413s] @file 14:
[12/31 13:43:38   1413s] @file 15: #5. Creating boundary constraints for Silago design blocks
[12/31 13:43:38   1413s] @file 16: for {set i 0} {$i < 8} {incr i} {
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s] #Top row	
[12/31 13:43:38   1413s]     #set x1 
[12/31 13:43:38   1413s]     set x1 [expr {double($margin + $tile_width * $i)}]
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s]     #set y1 
[12/31 13:43:38   1413s]     set y1 [expr {double($margin + $tile_height)}]
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s]     #set x2 
[12/31 13:43:38   1413s]     set x2 [expr {double($x1 + $tile_width)}]
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s]     #set y2 
[12/31 13:43:38   1413s]     set y2 [expr {double($y1 + $tile_height)}]
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s]     #set the cell 
[12/31 13:43:38   1413s]     set cell [lindex ${partition_hinst_list} $i]
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s]     #create_boundary_constraint for the cell
[12/31 13:43:38   1413s]     create_boundary_constraint -type fence -hinst $cell \
[12/31 13:43:38   1413s]         -rects [list [list $x1 $y1 $x2 $y2]]
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s] #Bottom row
[12/31 13:43:38   1413s]     #set x1 
[12/31 13:43:38   1413s]     set x1 [expr {double($margin + $tile_width * $i)}]
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s]     #set y1 
[12/31 13:43:38   1413s]     set y1 [expr {double($margin)}]
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s]     #set x2 
[12/31 13:43:38   1413s]     set x2 [expr {double($x1 + $tile_width)}]
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s]     #set y2 
[12/31 13:43:38   1413s]     set y2 [expr {double($y1 + $tile_height)}]
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s]     #set the cell 
[12/31 13:43:38   1413s]     set cell [lindex ${partition_hinst_list} [expr {$i + 8}]]
[12/31 13:43:38   1413s] 
[12/31 13:43:38   1413s]     #create_boundary_constraint for the cell
[12/31 13:43:38   1413s]     create_boundary_constraint -type fence -hinst $cell \
[12/31 13:43:38   1413s]         -rects [list [list $x1 $y1 $x2 $y2]]
[12/31 13:43:38   1413s] }
[12/31 13:43:38   1413s] @file 58:
[12/31 13:43:38   1413s] #@ End verbose source ../phy/scr/floorplan_constrained.tcl
